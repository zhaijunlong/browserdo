{
  "name": "browserdo-mcp",
  "version": "0.9.0",
  "description": "Built for AI agents. Shared with people. The MCP server for Embiody, the Windows browser your AI agent works in while you keep using your PC.",
  "mcpName": "io.github.zhaijunlong/browserdo",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Embiody Studio <connect@embiody.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaijunlong/browserdo.git"
  },
  "homepage": "https://github.com/zhaijunlong/browserdo#readme",
  "bugs": {
    "url": "https://github.com/zhaijunlong/browserdo/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "browserdo.config.example.yaml",
    "browserdo.config.example.json"
  ],
  "bin": {
    "browserdo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "dev": "tsc --watch",
    "check:comments": "node scripts/check-comments.mjs",
    "test:build": "tsc -p tsconfig.test.json",
    "pretest": "npm run check:comments",
    "pretest:fast": "npm run check:comments",
    "test": "npm run test:build && node --test \".test-out/test/unit/**/*.test.js\" \".test-out/test/module/**/*.test.js\" \".test-out/test/integration/**/*.test.js\" \".test-out/test/contract/**/*.test.js\"",
    "test:unit": "npm run test:build && node --test \".test-out/test/unit/**/*.test.js\"",
    "test:module": "npm run test:build && node --test \".test-out/test/module/**/*.test.js\"",
    "test:integration": "npm run test:build && node --test \".test-out/test/integration/**/*.test.js\"",
    "test:contract": "npm run test:build && node --test \".test-out/test/contract/**/*.test.js\"",
    "test:fast": "npm run test:build && node --test \".test-out/test/unit/**/*.test.js\" \".test-out/test/module/**/*.test.js\"",
    "test:live": "npm run test:build && node --test \".test-out/test/live/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "js-yaml": "^5.2.3",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^1.0.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.3"
  }
}
